# Copie para .env e substitua os exemplos por valores fortes e privados.
# Descomente e configure somente se desejar sobrescrever a chave local gerada.
# SECRET_KEY=
ADMIN_USERNAME=admin
# Deixe comentado para gerar uma senha administrativa aleatória no primeiro uso.
# ADMIN_PASSWORD=
DATABASE_PATH=instance/crm.sqlite3
COMPANY_NAME=Nexo CRM
COMPANY_EMAIL=contato@example.com
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_LOGO=static/img/logo.png
APP_PORT=5000
AUTO_OPEN_BROWSER=true
# Ative somente quando a aplicação estiver atrás de HTTPS.
COOKIE_SECURE=false
